# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to Git!

# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Project settings (used in Chapters 8-10)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Application API key for Chapter 9 protected endpoints
APP_API_KEY=change_me_in_production
